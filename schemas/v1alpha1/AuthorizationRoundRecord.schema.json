{
  "$defs": {
    "AuthorizationRoundPurpose": {
      "description": "Why a complete authority-and-policy decision round was evaluated.",
      "enum": [
        "STAGING",
        "PRECOMMIT",
        "RECOVERY"
      ],
      "title": "AuthorizationRoundPurpose",
      "type": "string"
    },
    "AuthorizationVerdict": {
      "description": "Fail-closed aggregate outcome of one authorization round.",
      "enum": [
        "ELIGIBLE",
        "DENIED",
        "UNKNOWN"
      ],
      "title": "AuthorizationVerdict",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Immutable link from one evaluation round to exact decision and reservation evidence.",
  "properties": {
    "allowed_modes": {
      "default": [],
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 16,
      "title": "Allowed Modes",
      "type": "array"
    },
    "api_version": {
      "const": "agentkernel.io/v1alpha1",
      "default": "agentkernel.io/v1alpha1",
      "title": "Api Version",
      "type": "string"
    },
    "authority_context_ref": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Authority Context Ref"
    },
    "authority_decision_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Authority Decision Digest",
      "type": "string"
    },
    "authority_decision_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,255}$",
      "title": "Authority Decision Id",
      "type": "string"
    },
    "authority_decision_record_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Authority Decision Record Digest",
      "type": "string"
    },
    "authority_decision_ref": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Authority Decision Ref"
    },
    "authority_snapshot_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Authority Snapshot Digest",
      "type": "string"
    },
    "authority_snapshot_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,255}$",
      "title": "Authority Snapshot Id",
      "type": "string"
    },
    "authority_snapshot_ref": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Authority Snapshot Ref"
    },
    "authority_valid_until": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Authority Valid Until"
    },
    "capability_reservation_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Capability Reservation Digest"
    },
    "capability_reservation_plan_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Capability Reservation Plan Digest"
    },
    "controlled_transaction_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,255}$",
      "title": "Controlled Transaction Id",
      "type": "string"
    },
    "evaluated_at": {
      "format": "date-time",
      "title": "Evaluated At",
      "type": "string"
    },
    "obligations": {
      "default": [],
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 64,
      "title": "Obligations",
      "type": "array"
    },
    "owner_history_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Owner History Digest",
      "type": "string"
    },
    "owner_history_sequence": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "title": "Owner History Sequence",
      "type": "integer"
    },
    "owner_version": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "title": "Owner Version",
      "type": "integer"
    },
    "policy_decision_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Policy Decision Digest",
      "type": "string"
    },
    "policy_decision_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,255}$",
      "title": "Policy Decision Id",
      "type": "string"
    },
    "policy_decision_record_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Policy Decision Record Digest",
      "type": "string"
    },
    "policy_decision_ref": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Policy Decision Ref"
    },
    "policy_inputs_ref": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Policy Inputs Ref"
    },
    "policy_snapshot_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Policy Snapshot Digest",
      "type": "string"
    },
    "policy_snapshot_ref": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Policy Snapshot Ref"
    },
    "purpose": {
      "$ref": "#/$defs/AuthorizationRoundPurpose"
    },
    "reason_code": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Reason Code",
      "type": "string"
    },
    "reservation_goal_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,255}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reservation Goal Id"
    },
    "reservation_run_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,255}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reservation Run Id"
    },
    "reservation_version": {
      "anyOf": [
        {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reservation Version"
    },
    "round_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Round Digest",
      "type": "string"
    },
    "round_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,255}$",
      "title": "Round Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.1",
      "enum": [
        "1.0",
        "1.1"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "subject_intent_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Subject Intent Hash",
      "type": "string"
    },
    "subject_normalized_action_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Subject Normalized Action Digest",
      "type": "string"
    },
    "subject_transaction_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,255}$",
      "title": "Subject Transaction Id",
      "type": "string"
    },
    "tenant_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,255}$",
      "title": "Tenant Id",
      "type": "string"
    },
    "verdict": {
      "$ref": "#/$defs/AuthorizationVerdict"
    }
  },
  "required": [
    "tenant_id",
    "controlled_transaction_id",
    "subject_transaction_id",
    "subject_intent_hash",
    "subject_normalized_action_digest",
    "round_id",
    "purpose",
    "verdict",
    "authority_snapshot_id",
    "authority_snapshot_digest",
    "authority_decision_id",
    "authority_decision_record_digest",
    "authority_decision_digest",
    "policy_decision_id",
    "policy_decision_record_digest",
    "policy_decision_digest",
    "policy_snapshot_digest",
    "owner_version",
    "owner_history_sequence",
    "owner_history_digest",
    "reason_code",
    "evaluated_at",
    "round_digest"
  ],
  "title": "AuthorizationRoundRecord",
  "type": "object"
}
