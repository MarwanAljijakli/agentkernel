        "DISCARD_STAGING",
        "RECONCILE_DISPATCH",
        "ROLLBACK",
        "COMPENSATE"
      ],
      "title": "RecoveryWorkKind",
      "type": "string"
    },
    "RecoveryWorkState": {
      "description": "Durable execution state for one bounded recovery item.",
      "enum": [
        "PENDING",
        "RUNNING",
        "RETRY_SCHEDULED",
        "RETRIED",
        "SUCCEEDED",
        "FAILED",
        "REVIEW_REQUIRED"
      ],
      "title": "RecoveryWorkState",
      "type": "string"
    }
  },
