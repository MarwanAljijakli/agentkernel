          "type": "string"
        },
        "target_owner_history_sequence": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Target Owner History Sequence",
          "type": "integer"
        },
        "target_owner_version": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Target Owner Version",
          "type": "integer"
        },
        "target_version_guard": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Target Version Guard",
          "type": "string"
        },
        "tenant_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,255}$",
          "title": "Tenant Id",
          "type": "string"
        },
        "transaction_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,255}$",
          "title": "Transaction Id",
          "type": "string"
        },
        "worker_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,255}$",
          "title": "Worker Id",
          "type": "string"
