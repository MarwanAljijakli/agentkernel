          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,255}$",
          "title": "Recovery Action Transaction Id",
          "type": "string"
        },
        "recovery_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,255}$",
          "title": "Recovery Id",
          "type": "string"
        },
        "recovery_kind": {
          "$ref": "#/$defs/RecoveryWorkKind"
        },
        "reservation_version": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Reservation Version",
          "type": "integer"
        },
        "target_evidence_ref": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Target Evidence Ref",
          "type": "string"
        },
        "target_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,255}$",
