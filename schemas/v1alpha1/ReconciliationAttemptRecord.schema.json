{
  "$defs": {
    "ReconciliationOutcome": {
      "description": "Evidence-only outcome returned by one reconciliation attempt.",
      "enum": [
        "COMMITTED",
        "NO_EFFECT",
        "PARTIAL_OR_INVALID",
        "UNKNOWN"
      ],
      "title": "ReconciliationOutcome",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One bounded evidence query for a previously dispatched intent.",
  "properties": {
    "attempt": {
      "maximum": 9223372036854775807,
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "committed_verification_permit_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Committed Verification Permit Digest"
    },
    "committed_verification_permit_ref": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Committed Verification Permit Ref"
    },
    "committed_verification_ref": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Committed Verification Ref"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "completion_evidence_refs": {
      "anyOf": [
        {
          "items": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 256,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completion Evidence Refs"
    },
    "dispatch_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,255}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "effect_receipt_ref": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Effect Receipt Ref"
    },
    "evidence_refs": {
      "default": [],
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 256,
      "title": "Evidence Refs",
      "type": "array"
    },
    "fencing_token": {
      "maximum": 9223372036854775807,
      "minimum": 1,
      "title": "Fencing Token",
      "type": "integer"
    },
    "intent_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Intent Hash",
      "type": "string"
    },
    "lease_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,255}$",
      "title": "Lease Id",
      "type": "string"
    },
    "next_attempt_not_before": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next Attempt Not Before"
    },
    "no_effect_evidence_ref": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "No Effect Evidence Ref"
    },
    "operation_evidence_ref": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Operation Evidence Ref"
    },
    "operation_reason_code": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,255}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Operation Reason Code"
    },
    "outcome": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReconciliationOutcome"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "recovery_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,255}$",
      "title": "Recovery Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.1",
      "enum": [
        "1.0",
        "1.1"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "tenant_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,255}$",
      "title": "Tenant Id",
      "type": "string"
    },
    "transaction_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,255}$",
      "title": "Transaction Id",
      "type": "string"
    },
    "version": {
      "default": 0,
      "maximum": 9223372036854775807,
      "minimum": 0,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "tenant_id",
    "transaction_id",
    "intent_hash",
    "dispatch_id",
    "recovery_id",
    "attempt",
    "lease_id",
    "fencing_token",
    "started_at"
  ],
  "title": "ReconciliationAttemptRecord",
  "type": "object"
}
