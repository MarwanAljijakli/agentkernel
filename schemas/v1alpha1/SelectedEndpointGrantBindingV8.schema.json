{
  "additionalProperties": false,
  "description": "One explicitly selected endpoint bound to the exact admitted grant content.",
  "properties": {
    "capability_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,255}$",
      "title": "Capability Id",
      "type": "string"
    },
    "grant_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Grant Digest",
      "type": "string"
    }
  },
  "required": [
    "capability_id",
    "grant_digest"
  ],
  "title": "SelectedEndpointGrantBindingV8",
  "type": "object"
}
