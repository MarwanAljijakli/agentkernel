{
  "$defs": {
    "IntendedOutcome": {
      "enum": [
        "ABORTED",
        "STALE_STATE"
      ],
      "title": "IntendedOutcome",
      "type": "string"
    },
    "TransactionState": {
      "description": "Normative durable transaction states from specification Section 8.2.",
      "enum": [
        "NEW",
        "PLANNED",
        "REJECTED",
        "AUTHORIZED_TO_STAGE",
        "STAGING",
        "STAGED",
        "STAGE_VERIFIED",
        "AWAITING_APPROVAL",
        "READY_TO_COMMIT",
        "COMMITTING",
        "COMMITTED",
        "FAILED",
        "ABORTING",
        "ABORTED",
        "STALE_STATE",
        "ROLLING_BACK",
        "ROLLED_BACK",
        "COMPENSATING",
        "COMPENSATED",
        "COMPENSATION_FAILED",
        "RECOVERY_FAILED",
        "IN_DOUBT",
        "RECONCILING"
      ],
      "title": "TransactionState",
      "type": "string"
    },
    "TransitionEvent": {
      "enum": [
        "proposal.valid",
        "proposal.validation_failed",
        "control.cancelled",
        "control.deadline_exceeded",
        "control.context_exited",
        "authority.staging_authorized",
        "authority_or_policy.denied",
        "worker.lease_acquired",
        "staging.succeeded",
        "staging.failed",
        "verification.staged_passed",
        "verification.staged_failed",
        "approval.required",
        "approval.not_required",
        "approval.granted",
        "approval.rejected",
        "commit.target_version_changed",
        "commit.revalidation_failed",
        "commit.guards_passed",
        "commit.verified",
        "commit.failed_no_effect",
        "commit.partial_or_invalid",
        "commit.outcome_unknown",
        "recovery.rollback_started",
        "recovery.compensation_started",
        "recovery.unavailable",
        "abort.discard_succeeded",
        "abort.discard_failed",
        "recovery.rollback_verified",
        "recovery.rollback_failed_or_unknown",
        "recovery.compensation_verified",
        "recovery.compensation_failed_or_unknown",
        "reconcile.started",
        "reconcile.committed",
        "reconcile.no_effect",
        "reconcile.partial_or_invalid",
        "reconcile.unknown"
      ],
      "title": "TransitionEvent",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Canonical evidence fixing the first recovery-state deadline into the event chain.",
  "properties": {
    "absolute_deadline": {
      "format": "date-time",
      "title": "Absolute Deadline",
      "type": "string"
    },
    "api_version": {
      "const": "agentkernel.io/v1alpha1",
      "default": "agentkernel.io/v1alpha1",
      "title": "Api Version",
      "type": "string"
    },
    "intended_outcome": {
      "anyOf": [
        {
          "$ref": "#/$defs/IntendedOutcome"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "previous_event_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Previous Event Digest",
      "type": "string"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "rule_id": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Rule Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_state": {
      "$ref": "#/$defs/TransactionState"
    },
    "target_state": {
      "$ref": "#/$defs/TransactionState"
    },
    "tenant_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,255}$",
      "title": "Tenant Id",
      "type": "string"
    },
    "transaction_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,255}$",
      "title": "Transaction Id",
      "type": "string"
    },
    "transaction_version": {
      "maximum": 9223372036854775807,
      "minimum": 1,
      "title": "Transaction Version",
      "type": "integer"
    },
    "transition_event": {
      "$ref": "#/$defs/TransitionEvent"
    }
  },
  "required": [
    "tenant_id",
    "transaction_id",
    "transaction_version",
    "rule_id",
    "transition_event",
    "source_state",
    "target_state",
    "previous_event_digest",
    "absolute_deadline",
    "recorded_at"
  ],
  "title": "TransactionRecoveryDeadlineRecord",
  "type": "object"
}
