{
  "$defs": {
    "IntendedOutcome": {
      "enum": [
        "ABORTED",
        "STALE_STATE"
      ],
      "title": "IntendedOutcome",
      "type": "string"
    },
    "TransactionState": {
      "description": "Normative durable transaction states from specification Section 8.2.",
      "enum": [
        "NEW",
        "PLANNED",
        "REJECTED",
        "AUTHORIZED_TO_STAGE",
        "STAGING",
        "STAGED",
        "STAGE_VERIFIED",
        "AWAITING_APPROVAL",
        "READY_TO_COMMIT",
        "COMMITTING",
        "COMMITTED",
        "FAILED",
        "ABORTING",
        "ABORTED",
        "STALE_STATE",
        "ROLLING_BACK",
        "ROLLED_BACK",
        "COMPENSATING",
        "COMPENSATED",
        "COMPENSATION_FAILED",
        "RECOVERY_FAILED",
        "IN_DOUBT",
        "RECONCILING"
      ],
      "title": "TransactionState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Tenant-first transaction projection used only by the enforced coordinator.",
  "properties": {
    "actor_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,255}$",
      "title": "Actor Id",
      "type": "string"
    },
    "adapter": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,255}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Adapter"
    },
    "adapter_manifest_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Adapter Manifest Digest"
    },
    "agent_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,255}$",
      "title": "Agent Id",
      "type": "string"
    },
    "allowed_modes": {
      "default": [],
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 16,
      "title": "Allowed Modes",
      "type": "array"
    },
    "api_version": {
      "const": "agentkernel.io/v1alpha1",
      "default": "agentkernel.io/v1alpha1",
      "title": "Api Version",
      "type": "string"
    },
    "authority_decision_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Authority Decision Digest"
    },
    "authorization_round_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Authorization Round Digest"
    },
    "authorization_round_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,255}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Authorization Round Id"
    },
    "capability_reservation_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Capability Reservation Digest"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "deadline": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Deadline"
    },
    "goal_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,255}$",
      "title": "Goal Id",
      "type": "string"
    },
    "intended_outcome": {
      "anyOf": [
        {
          "$ref": "#/$defs/IntendedOutcome"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "intent_hash": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Intent Hash"
    },
    "normalized_action_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Normalized Action Digest"
    },
    "obligations": {
      "default": [],
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 64,
      "title": "Obligations",
      "type": "array"
    },
    "on_behalf_of": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,255}$",
      "title": "On Behalf Of",
      "type": "string"
    },
    "operation": {
      "anyOf": [
        {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Operation"
    },
    "policy_decision_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Policy Decision Digest"
    },
    "policy_snapshot_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Policy Snapshot Digest"
    },
    "principal_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,255}$",
      "title": "Principal Id",
      "type": "string"
    },
    "reason_code": {
      "anyOf": [
        {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason Code"
    },
    "request_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Request Digest",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,255}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.1",
      "enum": [
        "1.0",
        "1.1"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/TransactionState"
    },
    "tenant_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,255}$",
      "title": "Tenant Id",
      "type": "string"
    },
    "trace_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,255}$",
      "title": "Trace Id",
      "type": "string"
    },
    "transaction_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,255}$",
      "title": "Transaction Id",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "version": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "tenant_id",
    "transaction_id",
    "principal_id",
    "goal_id",
    "run_id",
    "trace_id",
    "actor_id",
    "on_behalf_of",
    "agent_id",
    "request_digest",
    "state",
    "version",
    "created_at",
    "updated_at"
  ],
  "title": "EnforcedTransactionRecord",
  "type": "object"
}
